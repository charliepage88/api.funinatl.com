{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "appstract/laravel-meta": "^2.0",
        "atymic/twitter": "^3.4",
        "geocoder-php/algolia-places-provider": "^0.3",
        "guzzlehttp/guzzle": "^7.8",
        "http-interop/http-factory-guzzle": "^1.2",
        "igorw/get-in": "^1.0",
        "johngrogg/ics-parser": "^3.0",
        "jwilsson/spotify-web-api-php": "^7.0",
        "laravel/framework": "^12.0",
        "laravel/passport": "^12.0",
        "laravel/scout": "^10.24",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.5",
        "league/flysystem-aws-s3-v3": "^3.0",
        "meilisearch/meilisearch-php": "^1.16",
        "php-http/message": "^1.11",
        "predis/predis": "^2.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-newsletter": "^5.3",
        "spatie/laravel-permission": "^7.2",
        "spatie/laravel-responsecache": "^7.5",
        "spatie/laravel-sluggable": "^3.6",
        "spatie/laravel-tags": "^4.5",
        "symfony/browser-kit": "^7.0",
        "symfony/dom-crawler": "^7.0",
        "symfony/http-client": "^7.0",
        "willdurand/geocoder": "^4.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.8"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [],
        "post-update-cmd": []
    }
}
